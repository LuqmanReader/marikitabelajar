{
  "manifest_version": 3,
  "name": "LedgerPeer TYMBAFlex Bridge",
  "version": "0.2.0",
  "description": "Read-only diagnostic for ILE FA2/MA2 tutorials, chapter sets, and completion; optionally sync course outlines to LedgerPeer.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://flex.tymbaedu.com/*",
    "https://ile.flex.tymbaedu.com/*",
    "https://twofive.flex.tymbaedu.com/*",
    "https://luqmanreader.github.io/marikitabelajar/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flex.tymbaedu.com/*",
        "https://ile.flex.tymbaedu.com/*",
        "https://twofive.flex.tymbaedu.com/*"
      ],
      "js": [
        "parser.js",
        "tymba-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ile.flex.tymbaedu.com/*"
      ],
      "js": [
        "parser.js",
        "ile-diagnostic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://luqmanreader.github.io/marikitabelajar/tymbaflex-bridge.html*"
      ],
      "js": [
        "ledgerpeer-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TYMBAFlex ILE Diagnostic",
    "default_popup": "popup.html"
  }
}