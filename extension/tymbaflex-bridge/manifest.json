{
  "manifest_version": 3,
  "name": "LedgerPeer TYMBAFlex Bridge",
  "version": "0.4.0",
  "description": "Opt-in TYMBAFlex ILE and Group B course diagnostics plus student-owned quiz review accuracy dashboard.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://flex.tymbaedu.com/*",
    "https://ile.flex.tymbaedu.com/*",
    "https://twofive.flex.tymbaedu.com/*",
    "https://luqmanreader.github.io/marikitabelajar/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flex.tymbaedu.com/*",
        "https://ile.flex.tymbaedu.com/*",
        "https://twofive.flex.tymbaedu.com/*"
      ],
      "js": [
        "parser.js",
        "tymba-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ile.flex.tymbaedu.com/*",
        "https://twofive.flex.tymbaedu.com/*"
      ],
      "js": [
        "parser.js",
        "ile-diagnostic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://luqmanreader.github.io/marikitabelajar/tymbaflex-bridge.html*",
        "https://luqmanreader.github.io/marikitabelajar/tymbaflex-revision.html*"
      ],
      "js": [
        "ledgerpeer-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ile.flex.tymbaedu.com/mod/quiz/review.php*",
        "https://twofive.flex.tymbaedu.com/mod/quiz/review.php*"
      ],
      "js": [
        "quiz-review-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LedgerPeer TYMBAFlex Diagnostic & Quiz Review Capture",
    "default_popup": "popup.html"
  }
}